{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "none",
    "width": 24,
    "padding": {"top": 1, "right": 4}
  },
  "display": {
    "separator": "  │  ",
    "color": {"keys": "#B78CFF", "output": "#F3EDFF", "separator": "#9966FF"}
  },
  "modules": [
    {"type": "custom", "format": "MYO / VIOLET ABYSS", "outputColor": "#B78CFF"},
    "break",
    {"type": "title", "key": "User", "format": "{1}"},
    {"type": "os", "key": "OS"},
    {"type": "kernel", "key": "Kernel"},
    {"type": "shell", "key": "Shell"},
    {"type": "de", "key": "Desktop"},
    {"type": "wm", "key": "WM"},
    {"type": "terminal", "key": "Terminal"},
    "break",
    {"type": "cpu", "key": "CPU"},
    {"type": "gpu", "key": "GPU"},
    {"type": "memory", "key": "RAM"},
    {"type": "uptime", "key": "Uptime"},
    {"type": "packages", "key": "Packages"},
    {"type": "display", "key": "Resolution"},
    "break",
    {"type": "colors", "symbol": "circle"}
  ]
}
