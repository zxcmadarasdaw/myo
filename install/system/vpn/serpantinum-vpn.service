# Serpantinum VPN, TUN mode (stage 2). Installed by install/modules/vpn.sh.
# Not enabled at boot: the shell starts and stops it (polkit rule 49-serpantinum-vpn.rules).
# The config is written only by /usr/libexec/serpantinum/serp-vpn-root after `sing-box check`.
[Unit]
Description=Serpantinum VPN (sing-box TUN)
Documentation=https://sing-box.sagernet.org/
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/serpantinum-vpn/config.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=/usr/libexec/serpantinum/serp-vpn-root cleanup
ExecStart=/usr/libexec/serpantinum/serp-vpn-root run
ExecStopPost=/usr/libexec/serpantinum/serp-vpn-root cleanup
Restart=on-failure
RestartSec=3
# A hung sing-box is killed after 5 s; ExecStopPost then removes its routes.
TimeoutStopSec=5
KillMode=mixed
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
